# ==============================================================================
# AI RPA Lead Collector Backend - Environment Template (.env.example)
# ==============================================================================

# Cấu hình Ứng dụng & Server
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# Cấu hình CORS (Cho phép kết nối từ Frontend React / Vite)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Chế độ Thực thi (FIXTURE: Chạy offline an toàn; LIVE: Cào dữ liệu thực tế)
EXECUTION_MODE=FIXTURE
ALLOW_FIXTURE_FALLBACK=true

# Danh sách nguồn Live đã được phê duyệt (Mặc định để rỗng để chạy an toàn)
APPROVED_LIVE_SOURCES=[]

# Cấu hình LLM Provider (Nhập API Key của công ty tại đây khi cần chạy AI)
LLM_API_KEY=your_actual_llm_api_key_here
LLM_API_BASE_URL=https://api.company-llm.com/v1
